    ] },
    { "id": "nucConversations", "group": "Machines", "label": "Conversations on the NUC", "values": [
      { "value": "none", "label": "none", "set": { "machines.nuc.participants": [] } },
      { "value": "one", "label": "one listening", "set": { "machines.nuc.participants": [
        { "title": "home-server", "harness": "codex", "reach": "listening" }
      ] } }
    ] },
    { "id": "productVersion", "group": "Version", "label": "Sidevoice installed on the machines", "values": [
      { "value": "0.8.1", "label": "0.8.1", "set": { "machines.nuc.productVersion": "0.8.1", "machines.laptop.productVersion": "0.8.1", "local.saysVersion": true } },
      { "value": "unknown", "label": "unknown (none said)", "set": { "machines.nuc.productVersion": null, "machines.laptop.productVersion": null, "local.saysVersion": false } }
