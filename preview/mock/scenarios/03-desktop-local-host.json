{
  "id": "desktop-local-host",
  "title": "Desktop app with its local host",
  "summary": "The desktop app runs this computer's local host, in use, and the NUC is paired too. Walk the local host's states, its updates and its reach. Seeded, to try removing them: two other devices on this computer's host and two on the NUC (Revoke); the NUC and an old laptop (off) paired (Forget); agents connected, not connected, by hand only (Cursor on the NUC) and foreign (Cursor here); the models in use and three not used for 12, 45 and 120 days (this app can't delete them); ElevenLabs' key connected, OpenAI's not. New: Codex just found here and on the NUC, an update of this computer's host (0.4.0), and a setting from What's new (set up on the release before).",
  "view": "app",
  "defaults": { "setup": "earlier", "update": "available", "installed": "seeded", "keys": "elevenlabs" },
  "world": {
    "page": "none",
    "setup": "earlier",
    "machines": {
      "nuc": { "host": "NUC del salón", "reach": "direct", "paired": true, "pairedDaysAgo": 12,
        "devices": [
          { "name": "Sidevoice en Mac", "kind": "code", "daysAgo": 12, "mine": true },
          { "id": "nuc-iphone", "name": "Sidevoice en iPhone", "kind": "code", "daysAgo": 30, "seenDaysAgo": 1 },
          { "id": "nuc-android", "name": "Sidevoice en Android", "kind": "code", "daysAgo": 150, "seenDaysAgo": 70 }
        ],
        "participants": [] },
      "laptop": { "host": "Portátil viejo", "reach": "offline", "paired": true, "pairedDaysAgo": 90,
        "devices": [{ "name": "Sidevoice en Mac", "kind": "code", "daysAgo": 90, "mine": true }], "participants": [] }
    },
    "local": { "computerName": "Mac de Ana", "state": "running", "installed": true, "service": "launchd", "reach": "local-only",
      "inUse": true, "version": "0.3.0", "bundledVersion": "0.3.0", "update": "current",
      "devices": [
        { "name": "Sidevoice en Mac", "kind": "local", "daysAgo": 30, "mine": true },
        { "id": "local-iphone", "name": "Sidevoice en iPhone", "kind": "code", "daysAgo": 20, "seenDaysAgo": 1 },
        { "id": "local-ipad", "name": "Sidevoice en iPad", "kind": "code", "daysAgo": 55, "seenDaysAgo": 30 }
      ],
      "agents": [
        { "id": "claude", "registration": "connected", "actionable": false },
        { "id": "codex", "registration": "not-connected", "actionable": true },
        { "id": "cursor", "registration": "foreign", "actionable": false }
      ],
      "participants": [
        { "title": "sidevoice-core", "harness": "claude-code", "reach": "listening" }
      ] }
  },
  "options": [
    { "id": "setup", "group": "This device", "label": "First-run setup", "reload": true, "values": [
      { "value": "done", "label": "done: opens on the room, nothing new", "set": { "setup": "done" } },
      { "value": "earlier", "label": "done on the release before: what's new shows", "set": { "setup": "earlier" } },
      { "value": "pending", "label": "not done: opens on the setup", "set": { "setup": null } }
    ] },
    { "id": "localState", "group": "Local host", "label": "State", "values": [
      { "value": "running", "label": "running", "set": { "local.state": "running", "local.failure": null } },
      { "value": "starting", "label": "starting", "set": { "local.state": "starting", "local.failure": null } },
      { "value": "backoff", "label": "retrying (backoff)", "set": { "local.state": "backoff", "local.failure": { "key": "import.missing-module", "step": "service-start" } } },
      { "value": "failed", "label": "failed: missing module", "set": { "local.state": "failed", "local.failure": { "key": "import.missing-module", "step": "service-start" } } },
      { "value": "service-failed", "label": "service failed: start limit", "set": { "local.state": "service-failed", "local.failure": { "key": "start-limit", "step": "service" } } },
      { "value": "stopped", "label": "stopped by the person", "set": { "local.state": "stopped-by-person", "local.failure": null } },
      { "value": "not-installed", "label": "not installed as a service", "set": { "local.state": "not-installed", "local.installed": false, "local.failure": null } },
      { "value": "refused", "label": "refuses this app", "set": { "local.state": "refused", "local.failure": null } },
      { "value": "incompatible", "label": "incompatible", "set": { "local.state": "incompatible", "local.failure": null } }
    ] },
    { "id": "startsAs", "group": "Local host", "label": "A start ends", "values": [
      { "value": "running", "label": "running", "set": { "local.startsAs": "running" } },
      { "value": "failed", "label": "failed", "set": { "local.startsAs": "failed", "local.startFailure": { "key": "launch.exited", "step": "service-start" } } }
    ] },
    { "id": "reach", "group": "Local host", "label": "Reach of its codes", "values": [
      { "value": "local-only", "label": "this computer only", "set": { "local.reach": "local-only" } },
      { "value": "room", "label": "through the room", "set": { "local.reach": "room" } }
    ] },
    { "id": "update", "group": "Version", "label": "Update", "values": [
      { "value": "current", "label": "current", "set": { "local.update": "current", "local.bundledVersion": "0.3.0" } },
      { "value": "available", "label": "available (0.4.0)", "set": { "local.update": "available", "local.bundledVersion": "0.4.0" } },
      { "value": "newer-installed", "label": "the installed one is newer", "set": { "local.update": "newer-installed", "local.version": "0.5.0" } },
      { "value": "incompatible", "label": "incompatible", "set": { "local.update": "incompatible" } }
    ] },
    { "id": "inUse", "group": "Machines", "label": "In use when the page loads", "reload": true, "values": [
      { "value": "local", "label": "this computer", "set": { "local.inUse": true, "machines.nuc.inUse": false } },
      { "value": "nuc", "label": "the NUC", "set": { "local.inUse": false, "machines.nuc.inUse": true } }
    ] },
    { "id": "nucReach", "group": "Machines", "label": "The NUC answers", "values": [
      { "value": "direct", "label": "directly", "set": { "machines.nuc.reach": "direct" } },
      { "value": "offline", "label": "not at all", "set": { "machines.nuc.reach": "offline" } }
    ] }
  ]
}
