{
  "id": "desktop-local-host",
  "title": "Desktop app with its local host",
  "summary": "The desktop app runs this computer's local host, in use, and the NUC is paired too. Walk the local host's states (every one, nothing installed and the install command run too), its updates and its reach; as the desktop app, it installs Sidevoice itself (The app installs Sidevoice: no leaves only the install command). Seeded, to try removing them: this app, Mac de Ana, and two others on this computer's host (Safari on iPhone, Chrome on Mac) and three on the NUC (Safari on iPhone, Firefox on Windows, Edge on Windows), each with when it paired and was last seen (Revoke; Rename any, this one too); the NUC and an old laptop (answering through the room; the card turns it off) paired (Forget); the models in use and three not used for 12, 45 and 120 days (this app can't delete them); ElevenLabs' key connected, OpenAI's not. Agents on this computer, every state at once: Claude Code connected; Codex just found (New); Gemini CLI not connected; OpenCode set up by an older Sidevoice (Connect updates it); Windsurf with another 'sidevoice' entry; Zed whose MCP settings can't be read; Goose unknown; Cursor by hand only; Amp, whose Connect takes 8 s; GitHub Copilot CLI, whose Connect fails; nothing not installed (the connector lists only the agents installed on a machine; any other is connected by hand from Don’t see yours?). The NUC's agent search finds its three (the card makes it fail: timed out, or Sidevoice not running); the old laptop's finds Claude Code connected, Codex set up by an older Sidevoice and Cursor not connected. New: Codex just found here, an update of this computer's service (0.8.1 → 0.9.0), and a setting from What's new (set up on the release before). Seeded too: a transcript in the conversation on top (sidevoice-core on this computer), six messages to read (the card empties it).",
  "view": "app",
  "defaults": { "setup": "earlier", "update": "available", "installed": "seeded", "keys": "elevenlabs" },
  "world": {
    "page": "none",
    "setup": "earlier",
    "machines": {
      "nuc": { "host": "NUC del salón", "reach": "direct", "paired": true, "pairedDaysAgo": 12,
        "devices": [
          { "id": "nuc-self", "name": "nuc-salon", "kind": "local", "daysAgo": 180, "seenDaysAgo": 0 },
          { "name": "Mac de Ana", "kind": "code", "daysAgo": 12, "mine": true },
          { "id": "nuc-iphone", "name": "iPhone de Ana", "kind": "code", "daysAgo": 30, "seenDaysAgo": 1 },
          { "id": "nuc-windows", "name": "Chrome on Windows", "kind": "code", "daysAgo": 64, "seenDaysAgo": 9 },
          { "id": "nuc-edge", "name": "Edge on Windows", "kind": "code", "daysAgo": 150, "seenDaysAgo": 70 }
        ],
        "participants": [] },
      "laptop": { "host": "Portátil viejo", "reach": "room", "paired": true, "pairedDaysAgo": 90,
        "agents": [
          { "id": "claude", "registration": "connected", "actionable": false },
          { "id": "codex", "registration": "outdated", "actionable": false },
          { "id": "cursor", "registration": "not-connected", "actionable": true }
        ],
        "devices": [{ "name": "Mac de Ana", "kind": "code", "daysAgo": 90, "mine": true }], "participants": [] }
    },
    "local": { "computerName": "Mac de Ana", "state": "running", "installed": true, "service": "launchd", "reach": "local-only",
      "inUse": true, "version": "0.8.1", "bundledVersion": "0.8.1", "update": "current",
      "devices": [
        { "name": "Mac de Ana", "kind": "local", "daysAgo": 30, "mine": true },
        { "id": "local-iphone", "name": "iPhone de Ana", "kind": "code", "daysAgo": 20, "seenDaysAgo": 1 },
        { "id": "local-chrome", "name": "Chrome on Mac", "kind": "code", "daysAgo": 55, "seenDaysAgo": 30 }
      ],
      "agents": "every-state", "cursorBridge": { "state": "ready", "registration": "connected" },
      "participants": [
        { "title": "sidevoice-core", "harness": "claude-code", "reach": "listening", "history": [
          { "role": "user", "text": "Morning. Did the overnight build pass?", "minutesAgo": 40 },
          { "role": "assistant", "text": "It did, apart from one flaky test in the relay's reconnect suite. It passed when I ran it again.", "minutesAgo": 39 },
          { "role": "user", "text": "Can you look at why a call sometimes loses the last reply after a reconnect?", "minutesAgo": 25 },
          { "role": "assistant", "text": "Found it. The room only counted a reply as received once it had finished playing, so a call that dropped while the agent was still speaking came back one message behind, and the replay started after the reply it had missed. It now counts a reply as received the moment the page has it, so the replay picks up exactly where the call left off. I also added a test that drops the call halfway through a reply and checks that nothing goes missing.", "minutesAgo": 12 },
          { "role": "user", "text": "Great. Do the tests still pass?", "minutesAgo": 10 },
          { "role": "assistant", "text": "All of them: cargo test is green. The fix is in rust/control/room/history.rs if you want a look.", "minutesAgo": 9 }
        ] }
      ] }
  },
  "options": [
    { "id": "cursorBridge", "group": "Agents on this computer", "label": "Cursor readiness", "values": [
      { "value": "ready", "label": "Ready", "set": { "local.cursorBridge": { "state": "ready", "registration": "connected" } } },
      { "value": "needs_attention", "label": "Needs attention: bridge off", "set": { "local.cursorBridge": { "state": "needs_attention", "registration": "connected" } } },
      { "value": "unsupported", "label": "Not supported", "set": { "local.cursorBridge": { "state": "unsupported", "registration": "connected" } } },
      { "value": "unknown_code", "label": "Needs attention: unknown reason", "set": { "local.cursorBridge": { "state": "unknown_code", "registration": "connected" } } }
    ] },
    { "id": "setup", "group": "This device", "label": "First-run setup", "reload": true, "values": [
      { "value": "done", "label": "done: opens on the room, nothing new", "set": { "setup": "done" } },
      { "value": "earlier", "label": "done on the release before: what's new shows", "set": { "setup": "earlier" } },
      { "value": "pending", "label": "not done: opens on the setup", "set": { "setup": null } }
    ] },
    { "id": "localState", "group": "Local host", "label": "State", "values": [
      { "value": "running", "label": "running (answers)", "set": { "local.state": "running", "local.installed": true, "local.failure": null, "local.commandRun": null } },
      { "value": "absent", "label": "nothing installed (the install command)", "set": { "local.state": "absent", "local.installed": false, "local.failure": null, "local.commandRun": null } },
      { "value": "command", "label": "the install command run: starting…, then as a start ends", "set": { "local.state": "absent", "local.installed": false, "local.failure": null, "local.commandRun": true } },
      { "value": "not-installed", "label": "installed, its service not set up", "set": { "local.state": "not-installed", "local.installed": false, "local.failure": null, "local.commandRun": null } },
      { "value": "stopped", "label": "stopped by the person", "set": { "local.state": "stopped-by-person", "local.installed": true, "local.failure": null, "local.commandRun": null } },
      { "value": "starting", "label": "starting", "set": { "local.state": "starting", "local.installed": true, "local.failure": null, "local.commandRun": null } },
      { "value": "backoff", "label": "retrying (backoff)", "set": { "local.state": "backoff", "local.installed": true, "local.failure": { "key": "import.missing-module", "step": "service-start" }, "local.commandRun": null } },
      { "value": "failed", "label": "failed: missing module", "set": { "local.state": "failed", "local.installed": true, "local.failure": { "key": "import.missing-module", "step": "service-start" }, "local.commandRun": null } },
      { "value": "service-failed", "label": "service failed: start limit", "set": { "local.state": "service-failed", "local.installed": true, "local.failure": { "key": "start-limit", "step": "service" }, "local.commandRun": null } },
      { "value": "refused", "label": "refuses this app", "set": { "local.state": "refused", "local.installed": true, "local.failure": null, "local.commandRun": null } },
      { "value": "incompatible", "label": "incompatible", "set": { "local.state": "incompatible", "local.installed": true, "local.failure": null, "local.commandRun": null } }
    ] },
    { "id": "transcript", "group": "Local host", "label": "Transcript", "reload": true, "values": [
      { "value": "seeded", "label": "seeded: a conversation to read", "set": { "transcript": "seeded" } },
      { "value": "empty", "label": "empty: no history anywhere", "set": { "transcript": "empty" } }
    ] },
    { "id": "startsAs", "group": "Local host", "label": "A start ends", "values": [
      { "value": "running", "label": "running", "set": { "local.startsAs": "running" } },
      { "value": "failed", "label": "failed", "set": { "local.startsAs": "failed", "local.startFailure": { "key": "launch.exited", "step": "service-start" } } }
    ] },
    { "id": "appInstalls", "group": "Local host", "label": "The app installs Sidevoice", "reload": true, "values": [
      { "value": "yes", "label": "yes: Prepare this computer, the command below (as the desktop app)", "set": { "local.appInstalls": true } },
      { "value": "no", "label": "no: only the install command (an app without the install seam)", "set": { "local.appInstalls": false } }
    ] },
    { "id": "reach", "group": "Local host", "label": "Reach of its codes", "values": [
      { "value": "local-only", "label": "this computer only", "set": { "local.reach": "local-only" } },
      { "value": "room", "label": "through the room", "set": { "local.reach": "room" } }
    ] },
    { "id": "muteShortcut", "group": "Desktop app", "label": "Mute shortcut", "reload": true, "values": [
      { "value": "on", "label": "set (⌘⇧M)", "set": { "app.desktopSettings": true, "app.shortcut": "Cmd+Shift+M", "app.shortcutRefused": false } },
      { "value": "refused", "label": "refused by the system (another app has it)", "set": { "app.desktopSettings": true, "app.shortcut": "Cmd+Shift+M", "app.shortcutRefused": true } },
      { "value": "voiceover", "label": "clashes with VoiceOver (⌘F5)", "set": { "app.desktopSettings": true, "app.shortcut": "Cmd+F5", "app.shortcutRefused": false } },
      { "value": "off", "label": "not set", "set": { "app.desktopSettings": true, "app.shortcut": null, "app.shortcutRefused": false } },
      { "value": "absent", "label": "not offered (an older app)", "set": { "app.desktopSettings": false } }
    ] },
    { "id": "resetFailure", "group": "Desktop app", "label": "Data deletion", "values": [
      { "value": "none", "label": "succeeds after restart", "set": { "app.resetFailure": null } },
      { "value": "service", "label": "service uninstall fails", "set": { "app.resetFailure": "service" } },
      { "value": "models", "label": "models remain (partial result)", "set": { "app.resetFailure": "models" } }
    ] },
    { "id": "appChannel", "group": "Version", "label": "Desktop app build", "reload": true, "values": [
      { "value": "release", "label": "release", "set": { "app.channel": "release" } },
      { "value": "nightly", "label": "nightly", "set": { "app.channel": "nightly" } },
      { "value": "dev", "label": "development build", "set": { "app.channel": "dev" } }
    ] },
    { "id": "update", "group": "Version", "label": "Update", "values": [
      { "value": "current", "label": "current (0.8.1)", "set": { "local.update": "current", "local.version": "0.8.1", "local.bundledVersion": "0.8.1" } },
      { "value": "available", "label": "available (0.8.1 → 0.9.0)", "set": { "local.update": "available", "local.version": "0.8.1", "local.bundledVersion": "0.9.0" } },
      { "value": "newer-installed", "label": "the installed one is newer (0.9.0, the app bundles 0.8.1)", "set": { "local.update": "newer-installed", "local.version": "0.9.0", "local.bundledVersion": "0.8.1" } },
      { "value": "incompatible", "label": "incompatible", "set": { "local.update": "incompatible" } }
    ] },
    { "id": "inUse", "group": "Machines", "label": "In use when the page loads (a web with one machine at a time)", "reload": true, "values": [
      { "value": "local", "label": "this computer", "set": { "local.inUse": true, "machines.nuc.inUse": false } },
      { "value": "nuc", "label": "the NUC", "set": { "local.inUse": false, "machines.nuc.inUse": true } }
    ] },
    { "id": "nucReach", "group": "Machines", "label": "The NUC answers", "values": [
      { "value": "direct", "label": "directly", "set": { "machines.nuc.reach": "direct" } },
      { "value": "offline", "label": "not at all", "set": { "machines.nuc.reach": "offline" } }
    ] },
    { "id": "nucAgents", "group": "Machines", "label": "The NUC's agent search", "values": [
      { "value": "found", "label": "finds three (connected, new, by hand)", "set": { "machines.nuc.agentsFail": null } },
      { "value": "timeout", "label": "fails: timed out", "set": { "machines.nuc.agentsFail": "connector-timeout" } },
      { "value": "no-connector", "label": "fails: Sidevoice not running", "set": { "machines.nuc.agentsFail": "no-connector" } }
