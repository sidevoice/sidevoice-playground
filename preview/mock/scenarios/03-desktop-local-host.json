{
  "id": "desktop-local-host",
  "title": "Desktop app with its local host",
  "summary": "The desktop app runs this computer's local host, in use, and the NUC is paired too. Walk the local host's states, its updates and its reach. Seeded, to try removing them: this app, Mac de Ana, and two others on this computer's host (Safari on iPhone, Chrome on Mac) and three on the NUC (Safari on iPhone, Firefox on Windows, Edge on Windows), each with when it paired and was last seen (Revoke; Rename any, this one too); the NUC and an old laptop (answering through the room; the card turns it off) paired (Forget); the models in use and three not used for 12, 45 and 120 days (this app can't delete them); ElevenLabs' key connected, OpenAI's not. Agents on this computer, every state at once: Claude Code connected; Codex just found (New); Gemini CLI not connected; OpenCode set up by an older Sidevoice (Connect updates it); Windsurf with another 'sidevoice' entry; Zed whose MCP settings can't be read; Goose unknown; Cursor by hand only; Amp, whose Connect takes 8 s; GitHub Copilot CLI, whose Connect fails; Kiro connected but no longer installed; Continue not installed (hidden). The NUC's agent search finds its three (the card makes it fail: timed out, or Sidevoice not running); the old laptop's finds Claude Code connected, Codex set up by an older Sidevoice and Cursor not connected. New: Codex just found here, an update of this computer's host (0.4.0), and a setting from What's new (set up on the release before).",
  "view": "app",
  "defaults": { "setup": "earlier", "update": "available", "installed": "seeded", "keys": "elevenlabs" },
  "world": {
    "page": "none",
    "setup": "earlier",
    "machines": {
      "nuc": { "host": "NUC del salón", "reach": "direct", "paired": true, "pairedDaysAgo": 12,
        "devices": [
          { "id": "nuc-self", "name": "nuc-salon", "kind": "local", "daysAgo": 180, "seenDaysAgo": 0 },
          { "name": "Mac de Ana", "kind": "code", "daysAgo": 12, "mine": true },
          { "id": "nuc-iphone", "name": "iPhone de Ana", "kind": "code", "daysAgo": 30, "seenDaysAgo": 1 },
          { "id": "nuc-windows", "name": "Chrome on Windows", "kind": "code", "daysAgo": 64, "seenDaysAgo": 9 },
          { "id": "nuc-edge", "name": "Edge on Windows", "kind": "code", "daysAgo": 150, "seenDaysAgo": 70 }
        ],
        "participants": [] },
      "laptop": { "host": "Portátil viejo", "reach": "room", "paired": true, "pairedDaysAgo": 90,
        "agents": [
          { "id": "claude", "registration": "connected", "actionable": false },
          { "id": "codex", "registration": "outdated", "actionable": false },
          { "id": "cursor", "registration": "not-connected", "actionable": true }
        ],
        "devices": [{ "name": "Mac de Ana", "kind": "code", "daysAgo": 90, "mine": true }], "participants": [] }
    },
    "local": { "computerName": "Mac de Ana", "state": "running", "installed": true, "service": "launchd", "reach": "local-only",
      "inUse": true, "version": "0.3.0", "bundledVersion": "0.3.0", "update": "current",
      "devices": [
        { "name": "Mac de Ana", "kind": "local", "daysAgo": 30, "mine": true },
        { "id": "local-iphone", "name": "iPhone de Ana", "kind": "code", "daysAgo": 20, "seenDaysAgo": 1 },
        { "id": "local-chrome", "name": "Chrome on Mac", "kind": "code", "daysAgo": 55, "seenDaysAgo": 30 }
      ],
      "agents": "every-state",
      "participants": [
        { "title": "sidevoice-core", "harness": "claude-code", "reach": "listening" }
      ] }
  },
  "options": [
    { "id": "setup", "group": "This device", "label": "First-run setup", "reload": true, "values": [
      { "value": "done", "label": "done: opens on the room, nothing new", "set": { "setup": "done" } },
      { "value": "earlier", "label": "done on the release before: what's new shows", "set": { "setup": "earlier" } },
      { "value": "pending", "label": "not done: opens on the setup", "set": { "setup": null } }
    ] },
    { "id": "localState", "group": "Local host", "label": "State", "values": [
      { "value": "running", "label": "running", "set": { "local.state": "running", "local.failure": null } },
      { "value": "starting", "label": "starting", "set": { "local.state": "starting", "local.failure": null } },
      { "value": "backoff", "label": "retrying (backoff)", "set": { "local.state": "backoff", "local.failure": { "key": "import.missing-module", "step": "service-start" } } },
      { "value": "failed", "label": "failed: missing module", "set": { "local.state": "failed", "local.failure": { "key": "import.missing-module", "step": "service-start" } } },
      { "value": "service-failed", "label": "service failed: start limit", "set": { "local.state": "service-failed", "local.failure": { "key": "start-limit", "step": "service" } } },
      { "value": "stopped", "label": "stopped by the person", "set": { "local.state": "stopped-by-person", "local.failure": null } },
      { "value": "not-installed", "label": "not installed as a service", "set": { "local.state": "not-installed", "local.installed": false, "local.failure": null } },
      { "value": "refused", "label": "refuses this app", "set": { "local.state": "refused", "local.failure": null } },
      { "value": "incompatible", "label": "incompatible", "set": { "local.state": "incompatible", "local.failure": null } }
    ] },
    { "id": "startsAs", "group": "Local host", "label": "A start ends", "values": [
      { "value": "running", "label": "running", "set": { "local.startsAs": "running" } },
      { "value": "failed", "label": "failed", "set": { "local.startsAs": "failed", "local.startFailure": { "key": "launch.exited", "step": "service-start" } } }
    ] },
    { "id": "reach", "group": "Local host", "label": "Reach of its codes", "values": [
      { "value": "local-only", "label": "this computer only", "set": { "local.reach": "local-only" } },
      { "value": "room", "label": "through the room", "set": { "local.reach": "room" } }
    ] },
    { "id": "appChannel", "group": "Version", "label": "Desktop app build", "reload": true, "values": [
      { "value": "release", "label": "release", "set": { "app.channel": "release" } },
      { "value": "nightly", "label": "nightly (updates by hand)", "set": { "app.channel": "nightly" } },
      { "value": "dev", "label": "development build", "set": { "app.channel": "dev" } }
    ] },
    { "id": "update", "group": "Version", "label": "Update", "values": [
      { "value": "current", "label": "current", "set": { "local.update": "current", "local.bundledVersion": "0.3.0" } },
      { "value": "available", "label": "available (0.4.0)", "set": { "local.update": "available", "local.bundledVersion": "0.4.0" } },
      { "value": "newer-installed", "label": "the installed one is newer", "set": { "local.update": "newer-installed", "local.version": "0.5.0" } },
      { "value": "incompatible", "label": "incompatible", "set": { "local.update": "incompatible" } }
    ] },
    { "id": "inUse", "group": "Machines", "label": "In use when the page loads (a web with one machine at a time)", "reload": true, "values": [
      { "value": "local", "label": "this computer", "set": { "local.inUse": true, "machines.nuc.inUse": false } },
      { "value": "nuc", "label": "the NUC", "set": { "local.inUse": false, "machines.nuc.inUse": true } }
    ] },
    { "id": "nucReach", "group": "Machines", "label": "The NUC answers", "values": [
      { "value": "direct", "label": "directly", "set": { "machines.nuc.reach": "direct" } },
      { "value": "offline", "label": "not at all", "set": { "machines.nuc.reach": "offline" } }
    ] },
    { "id": "nucAgents", "group": "Machines", "label": "The NUC's agent search", "values": [
      { "value": "found", "label": "finds three (connected, new, by hand)", "set": { "machines.nuc.agentsFail": null } },
      { "value": "timeout", "label": "fails: timed out", "set": { "machines.nuc.agentsFail": "connector-timeout" } },
      { "value": "no-connector", "label": "fails: Sidevoice not running", "set": { "machines.nuc.agentsFail": "no-connector" } }
    ] },
    { "id": "laptopReach", "group": "Machines", "label": "The old laptop answers", "values": [
      { "value": "room", "label": "through the room", "set": { "machines.laptop.reach": "room" } },
      { "value": "offline", "label": "not at all (off)", "set": { "machines.laptop.reach": "offline" } }
    ] },
    { "id": "nucConversations", "group": "Machines", "label": "Conversations on the NUC", "values": [
      { "value": "none", "label": "none", "set": { "machines.nuc.participants": [] } },
      { "value": "one", "label": "one listening", "set": { "machines.nuc.participants": [
        { "title": "home-server", "harness": "codex", "reach": "listening" }
      ] } }
    ] },
    { "id": "productVersion", "group": "Version", "label": "Sidevoice installed on the machines", "values": [
      { "value": "0.8.1", "label": "0.8.1", "set": { "machines.nuc.productVersion": "0.8.1", "machines.laptop.productVersion": "0.8.1", "local.productVersion": "0.8.1" } },
      { "value": "unknown", "label": "unknown (none said)", "set": { "machines.nuc.productVersion": null, "machines.laptop.productVersion": null, "local.productVersion": null } }
    ] }
  ]
}
