      { "value": "failed", "label": "failed: missing module", "set": { "local.state": "failed", "local.installed": true, "local.failure": { "key": "import.missing-module", "step": "service-start" }, "local.commandRun": null } },
      { "value": "service-failed", "label": "service failed: start limit", "set": { "local.state": "service-failed", "local.installed": true, "local.failure": { "key": "start-limit", "step": "service" }, "local.commandRun": null } },
      { "value": "refused", "label": "refuses this app", "set": { "local.state": "refused", "local.installed": true, "local.failure": null, "local.commandRun": null } },
      { "value": "incompatible", "label": "incompatible", "set": { "local.state": "incompatible", "local.installed": true, "local.failure": null, "local.commandRun": null } },
      { "value": "running", "label": "running (answers)", "set": { "local.state": "running", "local.installed": true, "local.failure": null, "local.commandRun": null } }
