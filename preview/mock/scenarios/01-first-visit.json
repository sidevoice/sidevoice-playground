      { "value": "room", "label": "only through the room", "set": { "machines.nuc.reach": "room" } },
      { "value": "offline", "label": "off (the room says so)", "set": { "machines.nuc.reach": "offline" } },
      { "value": "away", "label": "nowhere (no answer)", "set": { "machines.nuc.reach": "away" } }
    ] },
