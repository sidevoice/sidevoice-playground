{
  "id": "first-visit",
  "title": "First visit: no machine yet",
  "summary": "Nothing paired, first-run setup not done. Pair the NUC with a code from the card, or, in the desktop app view, prepare this computer (the setup's Prepare this computer; Settings › Machines › This computer too): as the desktop app, Prepare installs it (download, verification, staging, service start; its failures below), with the install command to run by hand under it. Pick “the install command run” in This computer's State to have it run by hand: it starts, answers, and the setup moves on. Every other state this computer's Sidevoice can be in is there (Start, Retry, Reconnect…); “The app installs Sidevoice: no” leaves only the command.",
  "view": "browser",
  "world": {
    "page": "room",
    "machines": {
      "nuc": { "host": "NUC del salón", "reach": "direct", "paired": false, "devices": [], "participants": [
        { "title": "sidevoice-web", "harness": "claude-code", "reach": "listening" }
      ] }
    },
    "local": { "computerName": "Mac de Ana", "state": "absent", "installed": false, "reach": "local-only", "participants": [] }
  },
  "options": [
