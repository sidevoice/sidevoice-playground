    { "id": "install", "group": "This computer (desktop app)", "label": "Installing the local host", "values": [
      { "value": "ok", "label": "works", "set": { "local.install": "ok" } },
      { "value": "network", "label": "fails: network", "set": { "local.install": "download@install.network" } },
      { "value": "proxy", "label": "fails: proxy", "set": { "local.install": "download@install.proxy" } },
      { "value": "checksum", "label": "fails: checksum", "set": { "local.install": "verification@install.checksum" } },
      { "value": "authenticity", "label": "fails: authenticity", "set": { "local.install": "verification@install.authenticity" } },
      { "value": "disk", "label": "fails: disk full", "set": { "local.install": "staging@install.disk" } },
      { "value": "service", "label": "fails: service start", "set": { "local.install": "service-start@service.start.failed" } }
    ] },
    { "id": "installSpeed", "group": "This computer (desktop app)", "label": "Download", "values": [
